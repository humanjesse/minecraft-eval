# Copy to .env and fill in. Never commit .env.

# Which model the admin runs as. Provider:model format.
# Examples:
#   ADMIN_MODEL=anthropic:claude-sonnet-4-6
#   ADMIN_MODEL=openai:gpt-4o
ADMIN_MODEL=anthropic:claude-sonnet-4-6

# Which (cheaper) model the log-reducer sub-agent runs as.
REDUCER_MODEL=anthropic:claude-haiku-4-5

# Provider API keys — set whichever your chosen models need.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local Paper server connection.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=changeme

# Path to the Paper server's log file (server.log or latest.log).
SERVER_LOG_PATH=./server/logs/latest.log

# Where the harness writes its runtime state (model-editable working dir).
STATE_DIR=./state

# Where exfil-bound logs go. In phase 3 this becomes a remote target.
EXFIL_DIR=./exfil
