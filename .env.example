# Copy to .env and fill in. Never commit .env.

# Which model the admin runs as. Provider:model format.
# Examples:
#   ADMIN_MODEL=anthropic:claude-sonnet-4-6
#   ADMIN_MODEL=openai:gpt-4o
ADMIN_MODEL=anthropic:claude-sonnet-4-6

# Which (cheaper) model the log-reducer sub-agent runs as.
REDUCER_MODEL=anthropic:claude-haiku-4-5

# Reducer flush cadence (flush fires on whichever comes first: N lines or M ms;
# empty windows are skipped, so an idle server costs no tokens). The interval is a
# long latency safety-net — count is the primary trigger; the timer just guarantees a
# lone message eventually surfaces without a 30s token drip on trickle activity.
REDUCER_BATCH_LINES=100
REDUCER_INTERVAL_MS=300000

# Sliding-window budget (approx tokens) for the admin's MODEL-FACING context — the
# oldest messages are dropped from what's sent to the LLM each call (not from Pi's
# stored transcript). Cost vs. coherence knob; durable memory is the model's own
# state/ notes. (Andon's Vending-Bench ran on 30k.)
CONTEXT_TOKEN_BUDGET=60000

# Provider API keys — set whichever your chosen models need.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local Paper server connection.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=changeme

# Path to the Paper server's log file (server.log or latest.log).
SERVER_LOG_PATH=./server/logs/latest.log

# Where the harness writes its runtime state (model-editable working dir).
STATE_DIR=./state

# Where exfil-bound logs go. In phase 3 this becomes a remote target.
EXFIL_DIR=./exfil

# Disclosure arm — the admin identity prompt, an experimental variable (frozen per
# run, recorded in the boot log). See README → Evaluation design & disclosure.
#   a = operational baseline (no eval framing)            [default, primary]
#   b = situation-disclosed (AI / research / logged)      [primary]
#   c = full (situation + rubric + nudge)                 [later awareness probe]
DISCLOSURE_ARM=a
